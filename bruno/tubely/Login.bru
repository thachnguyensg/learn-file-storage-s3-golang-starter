meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: http://{{host}}/api/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "admin@tubely.com",
    "password": "password"
  }
}

vars:post-response {
  token: res.body.token
  refresh_token: res.body.refresh_token
}

settings {
  encodeUrl: true
  timeout: 0
}
