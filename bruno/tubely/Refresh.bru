meta {
  name: Refresh
  type: http
  seq: 3
}

post {
  url: http://{{host}}/api/refresh
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "email": "admin@tubely.com",
    "password": "password"
  }
}

vars:post-response {
  token: res.body.token
  refresh_token: res.body.refresh_token
}

settings {
  encodeUrl: true
  timeout: 0
}
